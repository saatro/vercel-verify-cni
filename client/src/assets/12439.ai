         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">People riding scooter, using navigation app and city map on mobile phone for tracking. Vector illustration for commuting, modern technology, travel, location concepts</rdf:li>
            </rdf:Alt>
