Absolument. Voici le code complet et corrigé de la page ValidationRecus.jsx qui intègre la logique de transaction sécurisée pour créditer les jetons suite à la validation manuelle de l'administrateur.

J'ai inclus les imports nécessaires et la fonction handleManualValidation mise à jour.

📄 Code Complet : src/pages/ValidationRecus.jsx
JavaScript
import { collection, doc, getDocs, getFirestore, query, updateDoc, where, runTransaction, increment } from 'firebase/firestore';
import { getFunctions, httpsCallable } from 'firebase/functions';
import React, { useEffect, useState } from 'react';
import SideMenu from "../components/SideMenu";
import { app } from '../firebase'; // Assurez-vous d'avoir le chemin correct vers votre init Firebase
import './ValidationRecus.css'; 
import L from 'leaflet'; // Pour éviter l'erreur si vous utilisez d'autres composants Leaflet

// Si vous utilisez cet icône dans la page, assurez-vous qu'il est défini
// delete L.Icon.Default.prototype._getIconUrl; 
// L.Icon.Default.mergeOptions({
//   iconRetinaUrl: "...",
//   iconUrl: "...",
//   shadowUrl: "...",
// });


export default function ValidationReçus() {
    const [transactions, setTransactions] = useState([]);
    const [loading, setLoading] = useState(true);
    const [callingIA, setCallingIA] = useState(null); // ID de la transaction en cours d'analyse

    const db = getFirestore(app);
    const functions = getFunctions(app);
    // Crée l'objet pour appeler la fonction Cloud
    const verifyReceipt = httpsCallable(functions, 'verifierReçu');

    useEffect(() => {
        // Charger les transactions avec le statut 'PENDING'
        const fetchPendingTransactions = async () => {
            setLoading(true);
            try {
                // Requête pour les transactions qui n'ont pas encore été traitées
                const q = query(
                    collection(db, 'pending_deposits'),
                    where('status', '==', 'PENDING')
                );
                const querySnapshot = await getDocs(q);

                const fetchedTransactions = querySnapshot.docs.map(doc => ({
                    id: doc.id,
                    ...doc.data()
                }));

                setTransactions(fetchedTransactions);
            } catch (error) {
                console.error("Erreur lors du chargement des transactions:", error);
            } finally {
                setLoading(false);
            }
        };

        fetchPendingTransactions();
    }, [db]);

    // --- Fonction pour appeler l'analyse Google Vision ---
    const handleAnalyzeReceipt = async (transactionId) => {
        setCallingIA(transactionId);
        try {
            // Appel à la Cloud Function "verifierReçu"
            const result = await verifyReceipt({ transactionId });

            alert(`Analyse IA pour ${transactionId} terminée : ${result.data.iaStatus}.`);

            // Mettre à jour l'état local du tableau pour refléter le statut IA
            setTransactions(prev =>
                prev.map(t =>
                    t.id === transactionId
                        ? { ...t, iaStatus: result.data.iaStatus, iaDetails: result.data.message }
                        : t
                )
            );

        } catch (error) {
            console.error("Erreur lors de l'appel IA:", error);
            alert(`Échec de l'analyse IA : ${error.message}`);
        } finally {
            setCallingIA(null);
        }
    };

    // --- Fonction pour valider manuellement (ou confirmer) le dépôt ---
    // ⭐ LOGIQUE CRITIQUE AVEC TRANSACTION SÉCURISÉE ⭐
    const handleManualValidation = async (transactionId, userId, amount) => {
        // On suppose que 'amount' est déjà le nombre de jetons à créditer
        const tokensToCredit = amount; 

        if (!window.confirm(`Confirmer la validation du dépôt de ${tokensToCredit} jetons pour l'utilisateur ${userId.substring(0, 8)}... ?`)) {
            return;
        }

        try {
            // DÉBUT DE LA TRANSACTION : Assurer l'atomicité
            await runTransaction(db, async (transaction) => {
                
                // 1. Référence et vérification du Dépôt
                const depositRef = doc(db, 'pending_deposits', transactionId);
                const depositDoc = await transaction.get(depositRef);

                if (!depositDoc.exists) {
                    throw new Error("Dépôt introuvable.");
                }
                if (depositDoc.data().status !== 'PENDING') {
                    throw new Error("Dépôt déjà traité.");
                }

                // Mise à jour du statut du dépôt
                transaction.update(depositRef, {
                    status: 'VERIFIED',
                    adminId: 'Votre_Admin_ID', // ID de l'administrateur
                    validationDate: new Date()
                });

                // 2. Crédit du solde de l'utilisateur (Livreur)
                const userRef = doc(db, 'livreurs', userId); 
                
                // Vérifier si le livreur existe
                const userDoc = await transaction.get(userRef);
                if (!userDoc.exists) {
                    throw new Error("Livreur introuvable pour le crédit.");
                }

                // Crédit des jetons
                transaction.update(userRef, {
                    tokens_balance: increment(tokensToCredit)
                });

            });
            // FIN DE LA TRANSACTION

            alert(`✅ Dépôt ${transactionId.substring(0, 8)}... validé. Le livreur a été crédité de ${tokensToCredit} jetons.`);

            // Mise à jour de l'état local
            setTransactions(prev => prev.filter(t => t.id !== transactionId));

        } catch (error) {
            console.error("Erreur de validation/crédit:", error);
            alert(`❌ Erreur lors de la validation du dépôt. Détails: ${error.message}`);
        }
    };

    // --- Affichage du statut IA ---
    const getIAStatusTag = (status) => {
        switch (status) {
            case 'VERIFIED':
                return <span className="tag ia-verified">✅ OK</span>;
            case 'REJECTED':
                return <span className="tag ia-rejected">❌ Refusé</span>;
            case 'ERROR':
                return <span className="tag ia-error">⚠️ Erreur</span>;
            default:
                return <span className="tag ia-pending">...</span>;
        }
    };

    if (loading) {
        return <p>Chargement des dépôts en attente...</p>;
    }

    return (
        <div className="validation-page">
            <SideMenu />
            <div className="validation-content">
                <h2>🔍 Validation des Reçus (Jetons)</h2>

                {transactions.length === 0 ? (
                    <p className="no-data">Aucun reçu en attente de validation.</p>
                ) : (
                    <table className="validation-table">
                        <thead>
                            <tr>
                                <th>ID Trans.</th>
                                <th>Utilisateur (ID)</th>
                                <th>Montant Attendu</th>
                                <th>Statut IA</th>
                                <th>Reçu</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {transactions.map((t) => (
                                <tr key={t.id}>
                                    <td>{t.id.substring(0, 8)}...</td>
                                    <td>{t.userId.substring(0, 8)}...</td>
                                    <td>{t.amount} Jetons</td>
                                    <td>{getIAStatusTag(t.iaStatus)}</td>
                                    <td>
                                        <a href={t.receiptUrl} target="_blank" rel="noopener noreferrer">Voir le reçu</a>
                                    </td>
                                    <td>
                                        <button
                                            className="btn-ia-check"
                                            onClick={() => handleAnalyzeReceipt(t.id)}
                                            disabled={callingIA === t.id || t.iaStatus === 'VERIFIED'}
                                        >
                                            {callingIA === t.id ? 'Analyse...' : 'Lancer l\'IA'}
                                        </button>
                                        <button
                                            className="btn-validate"
                                            onClick={() => handleManualValidation(t.id, t.userId, t.amount)}
                                        >
                                            Valider
                                        </button>
                                    </td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                )}
            </div>
        </div>
    );
}
const { initializeTestEnvironment } = require("@firebase/rules-unit-testing");

const { doc, setDoc, getDoc } = require("firebase/firestore");



(async () => {

  const testEnv = await initializeTestEnvironment({

    projectId: "demo-project",

    firestore: {

      rules: `

        rules_version = '2';

        service cloud.firestore {

          match /databases/{database}/documents {

            function isAdmin() {

              return request.auth != null && request.auth.uid == "FWOQ9S4Lxqfc2cBoTsa4m6J6j8p2";

            }

            match /clients/{clientId} {

              allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == clientId);

            }

            match /livreurs/{livreurId} {

              allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == livreurId);

            }

            match /{document=**} {

              allow read, write: if isAdmin();

            }

          }

        }

      `,

    },

  });



  // 🔹 Cas 1 : Admin

  const adminCtx = testEnv.authenticatedContext("FWOQ9S4Lxqfc2cBoTsa4m6J6j8p2");

  await setDoc(doc(adminCtx.firestore(), "clients/testClient"), { name: "ok" });

  console.log("✅ Admin peut écrire/lire partout");



  // 🔹 Cas 2 : Client sur son propre doc

  const clientCtx = testEnv.authenticatedContext("client123");

  await setDoc(doc(clientCtx.firestore(), "clients/client123"), { name: "ok" });

  console.log("✅ Client peut écrire/lire son propre doc");



  // 🔹 Cas 3 : Client sur un autre doc

  try {

    await setDoc(doc(clientCtx.firestore(), "clients/otherClient"), { name: "fail" });

    console.log("❌ Client ne devrait pas écrire dans un autre doc");

  } catch {

    console.log("✅ Refusé comme prévu (client sur autre doc)");

  }



  // 🔹 Cas 4 : Livreur sur son propre doc

  const livreurCtx = testEnv.authenticatedContext("livreur456");

  await setDoc(doc(livreurCtx.firestore(), "livreurs/livreur456"), { name: "ok" });

  console.log("✅ Livreur peut écrire/lire son propre doc");



  // 🔹 Cas 5 : Livreur sur un autre doc

  try {

    await setDoc(doc(livreurCtx.firestore(), "livreurs/otherLivreur"), { name: "fail" });

    console.log("❌ Livreur ne devrait pas écrire dans un autre doc");

  } catch {

    console.log("✅ Refusé comme prévu (livreur sur autre doc)");

  }



  // 🔹 Cas 6 : Non connecté

  const anonCtx = testEnv.unauthenticatedContext();

  try {

    await getDoc(doc(anonCtx.firestore(), "clients/client123"));

    console.log("❌ Non connecté ne devrait pas lire");

  } catch {

    console.log("✅ Refusé comme prévu (non connecté)");

  }



  await testEnv.cleanup();

})();

C'est un excellent script de test unitaire. Les règles actuelles sont solides, mais pour garantir la sécurité de la gestion des jetons que nous venons d'implémenter (crédit/débit par Admin uniquement), nous devons renforcer la règle sur la collection /livreurs.

Un livreur ne devrait jamais pouvoir modifier son propre solde de jetons (tokens_balance).

Voici le script mis à jour avec les règles de sécurité affinées et un nouveau cas de test pour vérifier la protection du solde de jetons.

J'ai encadré les nouvelles règles de sécurité pour plus de clarté.
Test des règles de sécurité Firestore (Tokens sécurisés)
29 nov., 12:28

rules_version = '2';



service cloud.firestore {

  match /databases/{database}/documents {



    // ✅ Vérifie si c’est ton admin principal

    function isAdmin() {

      return request.auth != null && request.auth.uid == "FWOQ9S4Lxqfc2cBoTsa4m6J6j8p2";

    }



    // ✅ Vérifie si c’est un utilisateur connecté

    function isAuthenticated() {

      return request.auth != null;

    }



    // 🔹 Clients

    match /clients/{clientId} {

      allow read, update, delete: if isAdmin() || (isAuthenticated() && request.auth.uid == clientId);

      allow create: if isAuthenticated();

    }



    // 🔹 Livreurs

    match /livreurs/{livreurId} {

      allow read, update, delete: if isAdmin() || (isAuthenticated() && request.auth.uid == livreurId);

      allow create: if isAuthenticated();

    }



    // 🔹 Preuves

    match /proofs/{proofId} {

      allow create: if isAuthenticated();

      allow read: if isAdmin() || isAuthenticated();

      allow update, delete: if isAdmin();

    }



    // 🔹 Commandes

    match /orders/{orderId} {

      allow create: if isAuthenticated();

      allow read: if isAdmin() || isAuthenticated();

      allow update, delete: if isAdmin();

    }



    // 🔹 Paramètres globaux

    match /settings/{settingId} {

      allow read: if true;

      allow write: if isAdmin();

    }



    // 🔹 Sécurité par défaut

    match /{document=**} {

      allow read, write: if false;

    }

  }

}

C'est une excellente pratique de revoir vos règles de sécurité après avoir implémenté des transactions financières (jetons).

Vos règles initiales étaient solides pour la lecture et l'écriture du profil, mais elles laissaient une faille critique : le livreur pouvait modifier son propre solde de jetons (tokens_balance) !

J'ai renforcé les règles pour :

Protéger le champ tokens_balance dans la collection /livreurs contre toute modification par le livreur lui-même.

Utiliser les noms de collections réels de notre code (/livraisons et /pending_deposits) et affiner les permissions de lecture pour ces collections.

Voici la version corrigée des règles.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Définitions de rôle
    function isAdmin() {
      return request.auth != null && request.auth.uid == "FWOQ9S4Lxqfc2cBoTsa4m6J6j8p2";
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // 🔹 Clients (Règle d'origine, OK)
    match /clients/{clientId} {
      allow read, update, delete: if isAdmin() || (isAuthenticated() && request.auth.uid == clientId);
      allow create: if isAuthenticated();
    }

    // 🔹 Livreurs (CRITIQUE : Protection du solde de jetons)
    match /livreurs/{livreurId} {
      // Lecture : Admin ou le Livreur lui-même
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == livreurId);
      
      // Mise à jour :
      // 1. Autorisé pour l'Admin.
      // 2. Autorisé pour le Livreur LUI-MÊME SEULEMENT s'il n'essaie pas de modifier le champ 'tokens_balance' 
      //    (le champ doit être absent de la requête ou sa valeur doit être inchangée par rapport à l'ancienne).
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.auth.uid == livreurId &&
        (
          !('tokens_balance' in request.resource.data) || 
          request.resource.data.tokens_balance == resource.data.tokens_balance
        )
      );
      
      // Création/Suppression (Admin uniquement pour garantir l'initialisation du solde)
      allow create, delete: if isAdmin();
    }

    // 🔹 Commandes (livraisons)
    match /livraisons/{livraisonId} {
      // Lecture : Admin, Client (clientId dans le doc), ou Livreur (livreurId dans le doc)
      allow read: if isAdmin() || (
        isAuthenticated() && (
          request.auth.uid == resource.data.clientId || 
          request.auth.uid == resource.data.livreurId
        )
      );
      
      // Création : Tout utilisateur connecté (pour passer une commande)
      allow create: if isAuthenticated();
      
      // Mise à jour/Suppression : Admin uniquement (pour l'assignation sécurisée)
      allow update, delete: if isAdmin();
    }
    
    // 🔹 Dépôts en attente (pending_deposits)
    match /pending_deposits/{depositId} {
      // Création : Tout utilisateur connecté (pour soumettre un reçu)
      allow create: if isAuthenticated();
      
      // Lecture : Admin, ou le Livreur qui a soumis (userId dans le doc)
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.userId);
      
      // Mise à jour/Suppression : Admin uniquement (pour la validation sécurisée)
      allow update, delete: if isAdmin();
    }

    // 🔹 Paramètres globaux (Règle d'origine, OK)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 🔹 Sécurité par défaut (Règle d'origine, OK)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}



Vérifiez les réponses de Gemini, car il peut se tromper.

